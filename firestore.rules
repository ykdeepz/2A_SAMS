rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ── departments — public read for signup form ──────────
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── registration_requests — anyone can submit ──────────
    match /registration_requests/{reqId} {
      allow read, write: if true;
    }

    // ── All other collections — any authenticated user ─────
    match /users/{docId} {
      allow read, write: if isAuth();
    }

    match /instructors/{docId} {
      allow read, write: if isAuth();
    }

    match /students/{docId} {
      allow read, write: if isAuth();
    }

    match /parents/{docId} {
      allow read, write: if isAuth();
    }

    match /subjects/{docId} {
      allow read, write: if isAuth();
    }

    match /enrollments/{docId} {
      allow read, write: if isAuth();
    }

    match /attendance/{docId} {
      allow read, write: if isAuth();
    }

  }
}
